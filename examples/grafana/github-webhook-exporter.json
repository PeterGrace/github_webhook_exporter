    {
      "id": 2,
      "title": "Webhook request rate",
      "description": "Webhook requests per second by bounded result.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(github_webhook_requests_total{job=~\"$job\", instance=~\"$instance\", repository=~\"$repository\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Accepted requests",
      "description": "Accepted share of observed webhook requests; zero traffic is guarded against division by zero.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(github_webhook_requests_total{job=~\"$job\", instance=~\"$instance\", repository=~\"$repository\", result=\"accepted\"}[$__rate_interval])) / clamp_min(sum(rate(github_webhook_requests_total{job=~\"$job\", instance=~\"$instance\", repository=~\"$repository\"}[$__rate_interval])), 1e-12)",
          "legendFormat": "Accepted",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 processing latency",
