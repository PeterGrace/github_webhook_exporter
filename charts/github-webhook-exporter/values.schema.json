{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[EPTGM]i?|Ki|k|[eE][+-]?[0-9]+|m)?$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "networkPeerRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "namespaceSelector", "podSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "podSelector": {"$ref": "#/definitions/labelSelector"}
      }
    },
    "otlpPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "podSelector": {"$ref": "#/definitions/labelSelector"},
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": {
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])$"
                },
                {
                  "pattern": "^[0-9A-Fa-f:]+/(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
                }
              ]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              {"required": ["namespaceSelector"]},
              {"required": ["podSelector"]}
            ]
          }
        },
        {
          "required": ["namespaceSelector", "podSelector"],
          "not": {"required": ["ipBlock"]}
        }
      ]
    },
    "tls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secretName", "hosts"],
        "properties": {
          "secretName": {"type": "string", "minLength": 1},
          "hosts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "existingSecret",
    "service",
    "application",
    "retention",
    "telemetry",
    "persistence",
    "resources",
    "probes",
    "terminationGracePeriodSeconds",
    "podDisruptionBudget",
    "webhookIngress",
    "metrics",
    "administration",
    "networkPolicy"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Always", "Never"]
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "keys"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "masterKey",
            "adminToken",
            "otlpHeaders",
            "otlpTracesHeaders",
            "otlpLogsHeaders"
          ],
          "properties": {
            "masterKey": {
              "type": "string",
              "minLength": 1
            },
            "adminToken": {
              "type": "string",
              "minLength": 1
            },
            "otlpHeaders": {
              "type": "string"
            },
            "otlpTracesHeaders": {
              "type": "string"
            },
            "otlpLogsHeaders": {
              "type": "string"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shutdownTimeoutSeconds",
        "webhookBodyLimitBytes",
        "workflowJobMaxSteps",
        "rustLog"
      ],
      "properties": {
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "webhookBodyLimitBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "workflowJobMaxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "rustLog": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryDays", "mergeQueueDays", "pruneIntervalSeconds"],
      "properties": {
        "deliveryDays": {
          "type": "integer",
          "minimum": 1
        },
        "mergeQueueDays": {
          "type": "integer",
          "minimum": 1
        },
        "pruneIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "tracesEndpoint",
        "logsEndpoint",
        "timeoutMilliseconds",
        "tracesTimeoutMilliseconds",
        "logsTimeoutMilliseconds",
        "serviceName",
        "queueCapacity",
        "batchSize",
        "shutdownTimeoutSeconds"
      ],
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "tracesEndpoint": {
          "type": "string"
        },
        "logsEndpoint": {
          "type": "string"
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "tracesTimeoutMilliseconds": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "logsTimeoutMilliseconds": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "serviceName": {
          "type": "string",
          "minLength": 1
        },
        "queueCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClass", "accessModes", "size"],
      "properties": {
        "storageClass": {
          "type": ["string", "null"]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce"]
          }
        },
        "size": {
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "webhookIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "host", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "host": {"type": "string"},
        "tls": {"$ref": "#/definitions/tls"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "serviceMonitor"],
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels", "interval", "scrapeTimeout"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"}
          }
        }
      }
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "ingress"],
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "annotations", "host", "tls"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "annotations": {"$ref": "#/definitions/stringMap"},
            "host": {"type": "string"},
            "tls": {"$ref": "#/definitions/tls"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ingressController", "prometheus", "management"],
          "properties": {
            "ingressController": {"$ref": "#/definitions/networkPeerRule"},
            "prometheus": {"$ref": "#/definitions/networkPeerRule"},
            "management": {"$ref": "#/definitions/networkPeerRule"}
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dns", "otlp"],
          "properties": {
            "dns": {"$ref": "#/definitions/networkPeerRule"},
            "otlp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "peers", "ports"],
              "properties": {
                "enabled": {"type": "boolean"},
                "peers": {
                  "type": "array",
                  "items": {"$ref": "#/definitions/otlpPeer"}
                },
                "ports": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 1, "maximum": 65535}
                }
              }
            }
          }
        }
      }
    }
  }
}
