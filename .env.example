# Copy this file to .env and replace every placeholder with values from a temporary Sentry project.
# Never commit .env or real Sentry credentials.

SENTRY_DSN=https://<public-key>@o<organization-id>.ingest.sentry.io/<project-id>
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://o<organization-id>.ingest.sentry.io/api/<project-id>/integration/otlp/v1/traces
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-sentry-auth=sentry%20sentry_key=<public-key>
